# Copie para ".env" e troque os valores. O ".env" NÃO vai para o Git.

# Chave secreta (use uma sequência longa e aleatória; não reutilize esta)
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Endereços pelos quais o sistema será acessado (ponto no início = qualquer subdomínio)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# Necessário para o login do /admin/ (inclua o endereço definitivo quando houver)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.trycloudflare.com

# Usuário administrador criado na primeira subida
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# Porta no seu computador (opcional)
PORTA=8080
